# Project D VM, restored from the Project C disk snapshot (never modify the snapshot: it is C's archive)
RG=rg-project-d
VM=vm-project-d
LOCATION=eastus
SNAPSHOT_ID=/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.Compute/snapshots/<snapshot>
SIZE=Standard_E8s_v6                 # 8 vCPU / 64 GB, $0.529/h
DISK_CONTROLLER=NVMe
DISK_GB=256                          # resize later (deallocate, az disk update --size-gb) if needed
DISK_SKU=Premium_LRS
ADMIN=azureuser
AUTO_SHUTDOWN_UTC=0700
